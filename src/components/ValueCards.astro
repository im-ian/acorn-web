---
import { useTranslations, type Lang } from "~/i18n/ui";
import { values, t as L } from "~/data/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section values">
  <div class="container">
    <header class="values__head reveal">
      <h2>{t("value.title")}</h2>
      <p>
        {
          t("value.lead")
            .split("\n")
            .map((line, i) => (
              <Fragment>
                {i > 0 && <br />}
                {line}
              </Fragment>
            ))
        }
      </p>
    </header>

    <div class="values__grid">
      {
        values.map((v) => (
          <article class="vcard reveal">
            <div class="vcard__icon" aria-hidden="true">
              {v.icon}
            </div>
            <h3>{L(v.title, lang)}</h3>
            <p>{L(v.body, lang)}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .values__head h2 {
    font-size: var(--text-h2);
    line-height: 1.12;
    max-width: min(100%, 20ch);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .values__head p {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: var(--text-lead);
    max-width: 46ch;
  }
  .values__grid {
    margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .vcard {
    padding-inline: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }
  .vcard:first-child {
    padding-left: 0;
  }
  .vcard:last-child {
    padding-right: 0;
  }
  .vcard + .vcard {
    border-left: 1px solid var(--border);
  }
  .vcard__icon {
    font-size: 1.7rem;
    line-height: 1;
  }
  .vcard h3 {
    margin-top: 1rem;
    font-size: var(--text-h3);
  }
  .vcard p {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  /* Mobile: stacked with padding only — no dividers. */
  @media (max-width: 860px) {
    .values__grid {
      grid-template-columns: 1fr;
    }
    .vcard,
    .vcard:first-child,
    .vcard:last-child,
    .vcard + .vcard {
      padding: 1.25rem 0;
      border-left: none;
    }
    .vcard:first-child {
      padding-top: 0;
    }
  }
</style>
