---
interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="pagehead">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
</section>

<style>
  .pagehead {
    padding-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-bottom: 1px solid var(--border);
  }
  .pagehead h1 {
    margin-top: 0.6rem;
    font-size: var(--text-h2);
    max-width: 20ch;
  }
  .pagehead p {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: var(--text-lead);
    max-width: 52ch;
  }
</style>
