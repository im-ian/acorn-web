---
import { languages, type Lang } from "~/i18n/ui";
import { switchLocalePath } from "~/lib/site";

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const entries = Object.keys(languages) as Lang[];
---

<div class="langtoggle" role="group" aria-label="Language">
  {
    entries.map((code) => (
      <a
        href={switchLocalePath(path, code)}
        class:list={["langtoggle__item", { "is-active": code === lang }]}
        aria-current={code === lang ? "true" : undefined}
      >
        {code.toUpperCase()}
      </a>
    ))
  }
</div>

<style>
  .langtoggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .langtoggle__item {
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    color: var(--muted);
    line-height: 1;
  }
  .langtoggle__item.is-active {
    background: var(--ink);
    color: var(--bg);
  }
</style>
