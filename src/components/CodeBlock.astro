---
interface Props {
  code: string;
  copyLabel: string;
  doneLabel: string;
}
const { code, copyLabel, doneLabel } = Astro.props;
---

<div class="codeblock">
  <div class="codeblock__scroll"><code>{code}</code></div>
  <button class="codeblock__copy" data-label-copy={copyLabel} data-label-done={doneLabel}>
    {copyLabel}
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".codeblock__copy").forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = "1";
    btn.addEventListener("click", async () => {
      const code = btn.closest(".codeblock")?.querySelector("code");
      const text = code?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = btn.dataset.labelDone ?? "Copied";
        btn.classList.add("is-done");
        setTimeout(() => {
          btn.textContent = btn.dataset.labelCopy ?? "Copy";
          btn.classList.remove("is-done");
        }, 1600);
      } catch {
        /* clipboard unavailable */
      }
    });
  });
</script>

<style>
  .codeblock {
    position: relative;
    background: var(--terminal-bg);
    border-radius: 12px;
  }
  .codeblock__scroll {
    overflow-x: auto;
    padding: 0.7rem 1.1rem;
    padding-right: 5.25rem;
  }
  .codeblock code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--terminal-fg);
    white-space: pre;
  }
  /* fade the right edge so scrolling code slips cleanly under the button */
  .codeblock::after {
    content: "";
    position: absolute;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: 4.5rem;
    border-radius: 0 12px 12px 0;
    background: linear-gradient(to right, transparent, var(--terminal-bg) 55%);
    pointer-events: none;
  }
  .codeblock__copy {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--terminal-bg);
    background: var(--terminal-fg);
    border: none;
    border-radius: 7px;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
  }
  .codeblock__copy.is-done {
    background: var(--status-run);
  }
</style>
