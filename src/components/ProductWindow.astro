---
import { useTranslations, type Lang } from "~/i18n/ui";
import { asset } from "~/lib/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="pw">
  <div class="container">
    <img
      class="pw__shot reveal"
      src={asset("screenshots/workspace.png")}
      width="1392"
      height="912"
      alt={t("window.caption")}
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style>
  .pw {
    padding-top: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .pw__shot {
    display: block;
    width: 100%;
    height: auto;
    max-width: 980px;
    margin-inline: auto;
  }
</style>
