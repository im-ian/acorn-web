---
import { type Lang } from "~/i18n/ui";
import { features, t as L } from "~/data/content";
import { asset } from "~/lib/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const slides = features.map((feature) => {
  const animated = feature.image.endsWith(".gif");
  return {
    src: feature.image,
    width: animated ? 1200 : 1600,
    height: animated ? 786 : 1000,
    title: L(feature.title, lang),
    description: L(feature.body, lang),
    alt: L(feature.alt, lang),
  };
});
---

<section class="pw">
  <div class="container">
    <div class="carousel reveal" data-carousel>
      <div class="carousel__viewport">
        {
          slides.map((s, i) => (
            <figure
              id={`carousel-slide-${i}`}
              class="carousel__slide"
              data-active={i === 0 ? "true" : "false"}
              aria-hidden={i === 0 ? "false" : "true"}
            >
              <img
                src={asset(s.src)}
                width={s.width}
                height={s.height}
                alt={s.alt}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={i === 0 ? "high" : "auto"}
              />
            </figure>
          ))
        }

        <button class="carousel__arrow carousel__arrow--prev" data-prev aria-label="Previous">‹</button>
        <button class="carousel__arrow carousel__arrow--next" data-next aria-label="Next">›</button>
      </div>

      <div class="carousel__meta">
        {
          slides.map((s, i) => (
            <div
              id={`carousel-caption-${i}`}
              class="carousel__caption"
              data-active={i === 0 ? "true" : "false"}
              aria-hidden={i === 0 ? "false" : "true"}
            >
              <span class="carousel__count" aria-hidden="true">
                {String(i + 1).padStart(2, "0")} / {String(slides.length).padStart(2, "0")}
              </span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="carousel__dots" role="tablist">
        {
          slides.map((s, i) => (
            <button
              class="carousel__dot"
              data-index={i}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-label={s.title}
              aria-controls={`carousel-slide-${i}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-carousel]");
  if (root) {
    const viewport = root.querySelector<HTMLElement>(".carousel__viewport");
    const slides = [...root.querySelectorAll<HTMLElement>(".carousel__slide")];
    const captions = [...root.querySelectorAll<HTMLElement>(".carousel__caption")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>(".carousel__dot")];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const DELAY = 4500;
    const SWIPE_THRESHOLD = 44;
    let index = 0;
    let timer: number | undefined;
    let swipeStartX = 0;
    let swipeStartY = 0;
    let swipePointerId: number | undefined;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === index;
        s.dataset.active = active ? "true" : "false";
        s.setAttribute("aria-hidden", active ? "false" : "true");
      });
      captions.forEach((caption, i) => {
        const active = i === index;
        caption.dataset.active = active ? "true" : "false";
        caption.setAttribute("aria-hidden", active ? "false" : "true");
      });
      dots.forEach((d, i) => d.setAttribute("aria-selected", i === index ? "true" : "false"));
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      if (reduce || timer) return;
      timer = window.setInterval(() => show(index + 1), DELAY);
    };

    dots.forEach((d, i) =>
      d.addEventListener("click", () => {
        show(i);
        stop();
        start();
      })
    );
    root.querySelector("[data-prev]")?.addEventListener("click", () => {
      show(index - 1);
      stop();
      start();
    });
    root.querySelector("[data-next]")?.addEventListener("click", () => {
      show(index + 1);
      stop();
      start();
    });
    viewport?.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse") return;
      swipePointerId = event.pointerId;
      swipeStartX = event.clientX;
      swipeStartY = event.clientY;
      try {
        viewport.setPointerCapture(event.pointerId);
      } catch {
        // Synthetic pointer events used in tests may not have an active pointer.
      }
      stop();
    });
    viewport?.addEventListener("pointerup", (event) => {
      if (swipePointerId !== event.pointerId) return;
      const dx = event.clientX - swipeStartX;
      const dy = event.clientY - swipeStartY;
      const isSwipe = Math.abs(dx) >= SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy) * 1.25;

      if (isSwipe) show(index + (dx < 0 ? 1 : -1));
      try {
        viewport.releasePointerCapture(event.pointerId);
      } catch {
        // The pointer may already be released after browser-level cancellation.
      }
      swipePointerId = undefined;
      start();
    });
    viewport?.addEventListener("pointercancel", () => {
      swipePointerId = undefined;
      start();
    });
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    document.addEventListener("visibilitychange", () =>
      document.hidden ? stop() : start()
    );

    start();
  }
</script>

<style>
  .pw {
    padding-top: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .carousel {
    max-width: 980px;
    margin-inline: auto;
  }
  .carousel__viewport {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card);
    overflow: hidden;
    touch-action: pan-y;
  }
  .carousel__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }
  .carousel__slide[data-active="true"] {
    opacity: 1;
    pointer-events: auto;
  }
  .carousel__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink);
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }
  .carousel:hover .carousel__arrow,
  .carousel__arrow:focus-visible {
    opacity: 1;
  }
  .carousel__arrow--prev {
    left: 12px;
  }
  .carousel__arrow--next {
    right: 12px;
  }
  .carousel__meta {
    display: grid;
    max-width: 820px;
    margin: 1.15rem auto 0;
  }
  .carousel__caption {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s 0.25s;
  }
  .carousel__caption[data-active="true"] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .carousel__count {
    padding-top: 0.2rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .carousel__caption h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .carousel__caption p {
    max-width: 66ch;
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }
  .carousel__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
    transition: background-color 0.2s ease, width 0.2s ease;
  }
  .carousel__dot[aria-selected="true"] {
    width: 22px;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel__slide,
    .carousel__caption {
      transition: none;
    }
  }
  @media (max-width: 560px) {
    .carousel__meta {
      margin-top: 0.9rem;
    }
    .carousel__caption {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 0.65rem;
    }
    .carousel__caption h3 {
      font-size: 1rem;
    }
    .carousel__caption p {
      font-size: 0.875rem;
      line-height: 1.5;
    }
  }
</style>
