---
import { useTranslations, type Lang } from "~/i18n/ui";
import { asset, links, installCommand } from "~/lib/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Gray floating circles: size / position / drift variant / duration.
const floats = [
  { s: 120, x: "5%", y: "14%", v: "a", d: 13 },
  { s: 70, x: "86%", y: "10%", v: "b", d: 17 },
  { s: 170, x: "78%", y: "52%", v: "a", d: 21 },
  { s: 46, x: "12%", y: "64%", v: "b", d: 15 },
  { s: 90, x: "44%", y: "6%", v: "a", d: 19 },
  { s: 58, x: "28%", y: "44%", v: "b", d: 23 },
];
---

<section class="hero">
  <div class="ac-floats" aria-hidden="true">
    {
      floats.map((f) => (
        <span
          style={`width:${f.s}px;height:${f.s}px;left:${f.x};top:${f.y};animation:ac-drift-${f.v} ${f.d}s ease-in-out infinite`}
        />
      ))
    }
  </div>

  <div class="container hero__inner">
    <img
      class="hero__icon"
      src={asset("acorn-icon-256.png")}
      width="88"
      height="88"
      alt="Acorn"
      fetchpriority="high"
    />
    <h1 class="hero__title">{t("hero.title")}</h1>
    <p class="hero__tagline">{t("hero.tagline")}</p>

    <div class="hero__cta">
      <a class="pill pill--primary" href={links.releasesLatest} target="_blank" rel="noopener">
        {t("hero.cta.download")}
      </a>
      <a class="pill pill--ghost" href={links.repo} target="_blank" rel="noopener">
        ★ {t("hero.cta.github")}
      </a>
    </div>

    <p class="hero__meta">
      {t("hero.meta")} —
      <a href={installCommand ? links.installScript : links.repo} target="_blank" rel="noopener"
        >{t("hero.meta.script")}</a
      >
      {t("hero.meta.or")}
      <a href={links.releasesLatest} target="_blank" rel="noopener">{t("hero.meta.dmg")}</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-top: clamp(3.5rem, 2rem + 6vw, 7rem);
    padding-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
  }
  .hero__icon {
    margin: 0 auto 1.6rem;
    filter: drop-shadow(0 10px 22px rgba(60, 40, 20, 0.18));
  }
  .hero__title {
    font-size: var(--text-hero);
    letter-spacing: -0.04em;
  }
  .hero__tagline {
    max-width: 34ch;
    margin: 1.1rem auto 0;
    font-size: var(--text-lead);
    color: color-mix(in oklab, var(--ink) 78%, var(--bg));
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.9rem;
  }
  .hero__meta {
    margin-top: 1.15rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .hero__meta a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
