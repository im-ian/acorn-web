---
import { useTranslations, type Lang } from "~/i18n/ui";
import { links } from "~/lib/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section cta">
  <div class="container cta__inner reveal">
    <h2>{t("cta.title")}</h2>
    <div class="cta__row">
      <a class="pill pill--accent" href={links.releasesLatest} target="_blank" rel="noopener">
        {t("cta.download")}
      </a>
      <a class="pill pill--ghost" href={links.repo} target="_blank" rel="noopener">
        ★ {t("cta.star")}
      </a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    text-align: center;
  }
  .cta__inner h2 {
    font-size: var(--text-h2);
    line-height: 1.12;
    max-width: min(100%, 16ch);
    margin-inline: auto;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .cta__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.8rem;
  }
</style>
